source "https://rubygems.org"

# The same Jekyll version and plugins that GitHub Pages uses to build the site.
# When https://pages.github.com/versions/ lists a newer `github-pages`, bump it here.
gem "github-pages", "~> 232", group: :jekyll_plugins

# `jekyll serve` needs a web server; Ruby 3 no longer ships one by default.
gem "webrick", "~> 1.8"
